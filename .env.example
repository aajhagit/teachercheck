# TeacherCheck AI Configuration
# Provide either GEMINI_API_KEY (Google AI Studio) or OPENAI_API_KEY
# The key stays securely on the server and is NEVER sent to the client.

GEMINI_API_KEY=
# OPENAI_API_KEY=

# Rate Limiting Configuration
# CHECK_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes window in milliseconds (default: 900000)
# CHECK_RATE_LIMIT_MAX=30           # Maximum requests per IP per window (default: 30)

# Optional CORS Origin Restriction (defaults to same-origin and localhost dev ports)
# ALLOWED_ORIGIN=http://localhost:5173
