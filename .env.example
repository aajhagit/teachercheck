# TeacherCheck AI Configuration
# Provide either GEMINI_API_KEY (Google AI Studio) or OPENAI_API_KEY
# The key stays securely on the server and is NEVER sent to the client.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# OPENAI_API_KEY=

# Rate Limiting Configuration
# CHECK_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes window in milliseconds (default: 900000)
# CHECK_RATE_LIMIT_MAX=30           # Maximum requests per IP per window (default: 30)

# Optional CORS Origin Restriction (defaults to same-origin and localhost dev ports)
# ALLOWED_ORIGIN=http://localhost:5173

# Supabase Authentication Configuration (Client Vite)
# Find these in Supabase Dashboard -> Project Settings -> API
# Note: Use the root Project URL (https://<project-ref>.supabase.co).
# Do not use the REST URL or append /rest/v1.
# Note: Never expose SUPABASE_SERVICE_ROLE_KEY to the client!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# Razorpay Subscriptions Plan IDs (Created in Razorpay Dashboard -> Subscriptions -> Plans)
# Optional: If unset, server falls back to fixed-price one-time orders at exact plan prices (₹199 / ₹1,999)
RAZORPAY_MONTHLY_PLAN_ID=plan_xxxxxxxxxxxxxx
RAZORPAY_YEARLY_PLAN_ID=plan_yyyyyyyyyyyyyy

# Razorpay Webhook Secret (Configured in Razorpay Dashboard -> Settings -> Webhooks)
# Used to verify x-razorpay-signature for subscription.charged, subscription.cancelled, etc.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Require user to be authenticated via Supabase before creating or verifying payments
# Recommended: true for production so Pro subscriptions are strictly bound to student accounts
REQUIRE_AUTH_FOR_PAYMENT=false
