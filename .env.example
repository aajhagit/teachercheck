# TeacherCheck AI Configuration
# Provide either GEMINI_API_KEY (Google AI Studio) or OPENAI_API_KEY
# The key stays securely on the server and is NEVER sent to the client.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# OPENAI_API_KEY=

# Rate Limiting Configuration
# CHECK_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes window in milliseconds (default: 900000)
# CHECK_RATE_LIMIT_MAX=30           # Maximum requests per IP per window (default: 30)

# Optional CORS Origin Restriction (defaults to same-origin and localhost dev ports)
# ALLOWED_ORIGIN=http://localhost:5173

# Supabase Authentication Configuration (Client Vite)
# Find these in Supabase Dashboard -> Project Settings -> API
# Note: Use the root Project URL (https://<project-ref>.supabase.co).
# Do not use the REST URL or append /rest/v1.
# Note: Never expose SUPABASE_SERVICE_ROLE_KEY to the client!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key
